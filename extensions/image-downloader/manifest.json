{
  "manifest_version": 3,
  "name": "词伴商品图片下载器",
  "version": "1.0.0",
  "description": "扫描当前网页中的商品图片并批量下载到本地。",
  "permissions": ["downloads", "activeTab"],
  "action": {
    "default_title": "扫描商品图片",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
